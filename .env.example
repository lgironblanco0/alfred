# Copia este archivo a .env y ajusta los valores:
#   Copy-Item .env.example .env
#
# .env no se versiona. Este ejemplo sí, para que cualquiera sepa
# qué variables necesita el proyecto.

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Conexión de Prisma. Es obligatoria: el esquema lee DATABASE_URL.
# PostgreSQL local o una base PostgreSQL gestionada (Neon en producción).
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/alfred?schema=public"

# Puerto del backend
PORT=3000

# Secreto para firmar los tokens JWT.
# En producción es obligatorio y debe tener al menos 32 caracteres.
# En desarrollo, si se omite, se usa un secreto interno solo para pruebas.
JWT_SECRET=cambia-este-secreto-de-desarrollo-de-32-caracteres

# Duración del token: 30m, 8h, 7d...
JWT_EXPIRES_IN=8h

# Nivel de logs: debug | info | warn | error | silent
LOG_LEVEL=info

# Orígenes permitidos por CORS, separados por comas.
# Si se omite, el backend acepta el entorno de desarrollo.
# CORS_ORIGINS=http://localhost:5173
