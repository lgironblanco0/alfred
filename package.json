{
  "name": "alfred",
  "version": "0.1.0",
  "description": "ALFRED — gestión de sala, comandas, cocina, barra y caja",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "verify": "npm run typecheck && npm run build && npm --prefix web run build && npm test",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:backup": "node scripts/backup-db.mjs",
    "postinstall": "prisma skills sync || exit 0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
